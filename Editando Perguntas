<?php

$id = $_GET["id"];

$arquivo = "perguntas.txt";

$linhas = file($arquivo, FILE_IGNORE_NEW_LINES);

$perguntaEncontrada = null;
$indice = -1;

foreach ($linhas as $i => $linha) {

    $dados = explode("|", $linha);

    if ($dados[0] == $id) {

        $perguntaEncontrada = $dados;
        $indice = $i;

        break;
    }
}

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    $desafio = $_POST["desafio"];
    $pergunta = $_POST["pergunta"];

    $tipo = $perguntaEncontrada[3];

    if ($tipo == "multipla") {

        $opcao1 = $_POST["opcao1"];
        $opcao2 = $_POST["opcao2"];
        $opcao3 = $_POST["opcao3"];
        $opcao4 = $_POST["opcao4"];
        $correta = $_POST["correta"];

        $linhaNova = $id . "|" .
                     $desafio . "|" .
                     $pergunta . "|" .
                     $tipo . "|" .
                     $opcao1 . "|" .
                     $opcao2 . "|" .
                     $opcao3 . "|" .
                     $opcao4 . "|" .
                     $correta;

    } else {

        $resposta = $_POST["resposta"];

        $linhaNova = $id . "|" .
                     $desafio . "|" .
                     $pergunta . "|" .
                     $tipo . "|" .
                     $resposta;
    }

    $linhas[$indice] = $linhaNova;

    file_put_contents($arquivo, implode(PHP_EOL, $linhas) . PHP_EOL);

    echo "<p>Pergunta alterada com sucesso!</p>";

    // Atualiza os dados exibidos
    $perguntaEncontrada = explode("|", $linhaNova);
}

?>

