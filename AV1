<?php

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    $desafio = $_POST["desafio"];
    $pergunta = $_POST["pergunta"];
    $tipo = $_POST["tipo"];

    if ($tipo == "multipla") {

        $opcao1 = $_POST["opcao1"];
        $opcao2 = $_POST["opcao2"];
        $opcao3 = $_POST["opcao3"];
        $opcao4 = $_POST["opcao4"];
        $correta = $_POST["correta"];

        $linha = $desafio . "|" . $pergunta . "|" . $tipo . "|" .
                 $opcao1 . "|" . $opcao2 . "|" . $opcao3 . "|" .
                 $opcao4 . "|" . $correta . PHP_EOL;

    } else {

        $resposta = $_POST["resposta"];

        $linha = $desafio . "|" . $pergunta . "|" . $tipo . "|" .
                 $resposta . PHP_EOL;
    }

    file_put_contents("perguntas.txt", $linha, FILE_APPEND);

    echo "Pergunta cadastrada!";
}
?>

