<?php

$arquivo = "usuarios.txt";

if (file_exists($arquivo)) {

    $linhas = file($arquivo, FILE_IGNORE_NEW_LINES);

} else {

    $linhas = [];
}

?>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Usuários</title>
