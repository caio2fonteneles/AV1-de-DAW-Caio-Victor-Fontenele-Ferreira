<?php

if (count($linhas) == 0) {

    echo "<p>Nenhum usuário cadastrado.</p>";

} else {

    foreach ($linhas as $linha) {

        $dados = explode("|", $linha);

        $id = $dados[0];
        $nome = $dados[1];
        $email = $dados[2];

        echo "<hr>";

        echo "<strong>ID:</strong> " . $id . "<br>";
        echo "<strong>Nome:</strong> " . $nome . "<br>";
        echo "<strong>E-mail:</strong> " . $email . "<br><br>";

        echo "<a href='editar_usuario.php?id=" . $id . "'>Editar</a>";

        echo " | ";

        echo "<a href='excluir_usuario.php?id=" . $id . "'>Excluir</a>";
    }
}

?>

