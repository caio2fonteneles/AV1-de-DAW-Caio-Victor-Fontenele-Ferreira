<?php

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    $nome = $_POST["nome"];
    $email = $_POST["email"];

    $id = time();

    $linha = $id . "|" .
             $nome . "|" .
             $email .
             PHP_EOL;

    file_put_contents(
        "usuarios.txt",
        $linha,
        FILE_APPEND
    );

    echo "<p>Usuário cadastrado com sucesso!</p>";
}

?>

