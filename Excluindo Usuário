<?php

$id = $_GET["id"];

$arquivo = "usuarios.txt";

$linhas = file($arquivo, FILE_IGNORE_NEW_LINES);

$novasLinhas = [];

foreach ($linhas as $linha) {

    $dados = explode("|", $linha);

    if ($dados[0] != $id) {

        $novasLinhas[] = $linha;
    }
}

file_put_contents(
    $arquivo,
    implode(PHP_EOL, $novasLinhas) . PHP_EOL
);

?>

